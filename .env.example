# Optional: native PostgreSQL. Local development defaults to SQLite.
# DATABASE_URL=postgresql+psycopg://erp:CHANGE_ME@127.0.0.1:5432/enterprisecloud

# Google Identity Services: web client ID (public identifier, no client secret required).
GOOGLE_CLIENT_ID=
GOOGLE_ADMIN_EMAIL=
# Additional new users allowed to enter with read-only role (comma-separated).
GOOGLE_ALLOWED_EMAILS=

# Allow new verified @gmail.com accounts to register with Consulta role.
GOOGLE_ALLOW_SIGNUP=false

# Production on Vercel: configure these in the project's environment variables.
# ERP_ENV=production
# COOKIE_SECURE=true
# ERP_ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
# DOCUMENT_STORAGE=database
